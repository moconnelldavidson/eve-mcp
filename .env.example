# Copy this file to .env and fill it in. Never commit .env.

# From your application at https://developers.eveonline.com/
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Must match the callback URL registered on the application exactly.
EVE_CALLBACK_URL=http://localhost:8765/callback

# Optional: the character the tools use when none is named.
# Leave empty to use the first character you signed in.
EVE_DEFAULT_CHARACTER=

# CCP asks API clients to identify themselves with contact details,
# for example: eve-mcp (you@example.com)
EVE_USER_AGENT=
